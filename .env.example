# Optional local-only document and networking settings. No provider key is needed.
# Set these only when enabling document generation. Never commit .env.local.
JOBAGENT_CANDIDATE_NAME="Your name"
JOBAGENT_CANDIDATE_EMAIL="your-email@example.com"
JOBAGENT_LINKEDIN_URL="https://www.linkedin.com/in/your-profile"
JOBAGENT_PORTFOLIO_URL="https://portfolio.example.com"
# JOBAGENT_LINKEDIN_EXPORT="/path/to/your-export.zip"
# Optional JobTracker integration; the default workflow uses applied_jobs.json.
# JOBTRACKER_SSH_HOST="your-host-alias"
# JOBTRACKER_ANALYTICS_IMPORT_TOKEN=""
