USAJOBS_USER_AGENT=your-email@example.com
USAJOBS_AUTHORIZATION_KEY=your-usajobs-api-key
JOBAGENT_CANDIDATE_NAME="Candidate Name"
JOBAGENT_CANDIDATE_EMAIL=candidate@example.com
JOBAGENT_RESUME_LINKEDIN_URL=https://www.linkedin.com/in/candidate-profile
JOBAGENT_RESUME_PORTFOLIO_URL=https://portfolio.example.com
JOBAGENT_LINKEDIN_URL=https://www.linkedin.com/in/candidate-profile
JOBAGENT_PORTFOLIO_URL=https://portfolio.example.com
JOBAGENT_SOURCE_RESUME_GLOB="*_SOURCE_*.docx"
JOBAGENT_LINKEDIN_EXPORT=/path/to/linkedin-export.zip
JOBAGENT_NETWORKING_BACKGROUND="senior software engineering, APIs, integrations, and technical leadership"
JOBTRACKER_SSH_HOST=jobtracker-host
JOBTRACKER_DB_PATH=/var/lib/jobtracker/jobtracker.db
JOBTRACKER_ANALYTICS_URL=http://127.0.0.1:8086/api/analytics/workflow-runs
JOBTRACKER_ANALYTICS_IMPORT_TOKEN=your-dedicated-jobtracker-analytics-token
